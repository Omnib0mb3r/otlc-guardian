# ============================================================
# OTLC Guardian — .gitignore
# // onthelevelconcepts.com
# ============================================================

# ── Secrets — NEVER commit these ────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# ── Node.js ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.pnpm-store/
.yarn/

# ── Build output ────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.turbo/
.vite/
*.tsbuildinfo

# ── Test / coverage ─────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
.cache/

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
pip-log.txt
pip-delete-this-directory.txt

# ── IDE / editors ───────────────────────────────────────────
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS junk ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
log/

# ── Claude Code working state ───────────────────────────────
# Keep .claude/settings.json and .claude/hooks/ — ignore everything else
.claude/cache/
.claude/state/
.claude/logs/
.claude/projects/

# ── GSD / planning artifacts (optional — uncomment to ignore) ──
# .planning/

# ── Misc ────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
.history/
