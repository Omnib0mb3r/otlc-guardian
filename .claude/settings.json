{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/injection-guard-hook.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/web-content-guard.mjs"
          }
        ]
      }
    ]
  },
  "otlcGuardian": {
    "extendDefaults": true,
    "watchPaths": [],
    "ignorePaths": []
  }
}
