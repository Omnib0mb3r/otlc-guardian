# ============================================================
# OTLC Guardian — Environment Variable Template
# // onthelevelconcepts.com
# ============================================================
#
# Copy this file to .env and fill in real values.
# .env is gitignored — it must NEVER be committed.
#
# On Windows, register persistent values with:
#   [System.Environment]::SetEnvironmentVariable("KEY", "value", "User")
#
# On Linux/Mac, add exports to ~/.zshrc or ~/.bashrc.
# ============================================================

# ── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SERVICE_NAME=my-service
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string — required by validateEnv() at startup
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── Cache / Queue ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ──────────────────────────────────────────
# JWT_SECRET must be at least 32 characters in production
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins — never use * in production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── AI Providers ────────────────────────────────────────────
OPENAI_API_KEY=sk-replace-with-your-openai-key
ANTHROPIC_API_KEY=sk-ant-replace-with-your-anthropic-key

# ── Error Monitoring ────────────────────────────────────────
# Sentry DSN — leave empty in development
SENTRY_DSN=

# ── Frontend (Vite) ─────────────────────────────────────────
# Variables exposed to the browser must be prefixed with VITE_
VITE_API_URL=http://localhost:3000
